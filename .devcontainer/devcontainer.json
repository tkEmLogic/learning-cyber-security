{
  "name": "Tier 0 Zephyr/ESP32-C6 toolchain",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // The repo checkout is the default bind-mounted workspace folder. The
  // Zephyr workspace (west modules, SDK, build output) is large, slow to
  // provision, and explicitly kept outside the repo (see
  // docs/esp32c6-build-baseline.md), so it lives on its own named volume
  // instead: it survives `Rebuild Container` and image updates.
  "mounts": [
    "source=zephyr-workspace,target=/opt/zephyr-workspace,type=volume"
  ],
  "containerEnv": {
    "ZEPHYR_WORKSPACE": "/opt/zephyr-workspace",
    "WORKSPACE_ROOT": "${containerWorkspaceFolder}"
  },
  // Grants access to the ESP32-C6's USB-JTAG/serial device. `keep-groups` is
  // a Podman-only flag (see .devcontainer/README.md for the Docker
  // equivalent) that keeps the invoking host user's supplementary groups
  // (e.g. dialout/plugdev), so no in-container group juggling is needed.
  // Plug the board in *before* opening/rebuilding the container: Podman
  // resolves --device at container start and fails if the path is absent.
  //
  // The device path is host-specific (it embeds this board's serial
  // number), so it is never hard-coded here. Export ESP32_SERIAL_DEVICE in
  // your shell before launching VS Code, pointed at your board's stable
  // path under /dev/serial/by-id/ (see docs/esp32c6-build-baseline.md).
  // Defaults to /dev/ttyACM0 when unset, which is fine when only one board
  // is ever attached.
  //
  // /dev/bus/usb is mounted whole because on-chip debugging talks to the
  // board's USB-Serial/JTAG interface through libusb, not through the serial
  // node, and the device path changes whenever the board re-enumerates.
  //
  // /dev/serial/by-id is mounted rather than passed with --device because a
  // by-id name that contains colons (an Espressif USB-JTAG serial number is a
  // MAC address) cannot be expressed in podman's host:container --device
  // syntax.
  //
  // label=disable is needed on SELinux hosts such as Fedora. Without it the
  // container is denied access to tty_device_t and every flash attempt fails
  // with a permission error that looks like a missing group.
  // The OTA service runs as a plain process inside this container. Publishing
  // 8080 and 8443 on every host address lets a physical ESP32-C6 reach it over
  // the host's private network. Loopback would be enough for host-only work
  // but would make the board unreachable, which is the whole Tier 0 exercise.
  //
  // Tier 0 uses 8080 alone. Tier 2 moves release records, firmware, and events
  // to 8443 and leaves health and the course marker on 8080.
  // NET_RAW is dropped from Podman's defaults since 4.4.0, and it is missing
  // from the bounding set, so setcap inside the container cannot recover it.
  // Without it the Tier 2 packet capture produces no file. The capability is
  // scoped to this container and the capture itself is bounded by
  // docs/fixture-safety-contract.md: one interface, manifest ports only, a
  // filter the course builds, and no promiscuous mode.
  "runArgs": [
    "--publish=0.0.0.0:8080:8080",
    "--publish=0.0.0.0:8443:8443",
    "--cap-add=NET_RAW",
    "--group-add=keep-groups",
    "--security-opt=label=disable",
    "--device=${localEnv:ESP32_SERIAL_DEVICE:/dev/ttyACM0}",
    "--volume=/dev/bus/usb:/dev/bus/usb",
    "--volume=/dev/serial/by-id:/dev/serial/by-id:ro"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "golang.go",
        "marus25.cortex-debug"
      ]
    }
  }
}
