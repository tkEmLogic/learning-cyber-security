# Configuration for the Tier 0 Reference product.
#
# Every value here is generated by `./course build firmware` from the
# disposable Course environment. Nothing in this file carries a real
# credential: the Wi-Fi passphrase arrives from `.course-secrets/wifi.conf`,
# which Git ignores.

menu "Course Reference product"

config COURSE_WIFI_SSID
	string "Course Wi-Fi network name"
	default ""
	help
	  The 2.4 GHz WPA2 network that the Reference product joins. The board
	  refuses to start its OTA client while this is empty.

config COURSE_WIFI_PSK
	string "Course Wi-Fi passphrase"
	default ""
	help
	  The WPA2 passphrase for the course network. Tier 0 stores it in plain
	  text in the built image on purpose, and the Weakness ledger records
	  that.

config COURSE_WIFI_CONNECT_TIMEOUT_SECONDS
	int "Seconds to wait for an address"
	default 60

config COURSE_OTA_HOST
	string "OTA service IPv4 address"
	default "127.0.0.1"
	help
	  The literal address of the local OTA service. Tier 0 uses an address,
	  not a name, so the device performs no name lookup.

config COURSE_OTA_PORT
	int "OTA service TCP port"
	default 8080

config COURSE_DEVICE_ID
	string "Synthetic device identifier"
	default "beacon-development-shared"
	help
	  The shared development identifier. Every Tier 0 device reports the
	  same value, which is the weakness the device-ID spoofing fixture
	  demonstrates.

config COURSE_RELEASE_ID
	string "Release identifier built into this image"
	default "tier-00-baseline"
	help
	  The device compares this value with the release the OTA service
	  assigns. A different value starts an update. Tier 0 has no other
	  version policy.

config COURSE_IMAGE_LABEL
	string "Human-readable label for this image"
	default "baseline"

config COURSE_BEACON_STATE
	string "Simulated machine state at boot"
	default "steady"
	help
	  One of steady, fast, or slow. The altered image uses a different
	  value so the Learner can see on the serial console which image runs.

config COURSE_POLL_INTERVAL_SECONDS
	int "Seconds between status reports"
	default 30

endmenu

source "Kconfig.zephyr"
